{
  // ===== Python 解释器与虚拟环境 =====
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
  "python.terminal.activateEnvironment": true,
  "python.envFile": "${workspaceFolder}/.env.dev",

  // ===== Python 分析 =====
  "python.analysis.extraPaths": ["${workspaceFolder}"],
  "python.analysis.typeCheckingMode": "basic",
  "python.analysis.inlayHints.functionReturnTypes": true,
  "python.analysis.inlayHints.variableTypes": true,

  // ===== Black 格式化 =====
  "black-formatter.args": ["--line-length", "88"],

  // ===== Flake8 检查 =====
  "flake8.args": ["--max-line-length=88", "--extend-ignore=E203,W503"],

  // ===== isort 导入排序 =====
  "isort.args": ["--profile", "black", "--line-length", "88"],

  // ===== FastAPI Runner =====
  // 注意：以下为项目专属值，按实际项目结构调整后再落盘
  "fastapi-runner.host": "127.0.0.1",
  "fastapi-runner.port": 3333,
  "fastapi-runner.reload": true,
  "fastapi-runner.defaultFile": "main:app",
  "fastapi-runner.workingDirectory": "app",
  "fastapi-runner.autoDetectVenv": true,
  "fastapi-runner.useModuleMode": true,

  // ===== Python 文件专属 =====
  "[python]": {
    "editor.defaultFormatter": "ms-python.black-formatter",
    "editor.codeActionsOnSave": {
      "source.organizeImports": "explicit",
      "source.fixAll": "explicit"
    }
  }
}
